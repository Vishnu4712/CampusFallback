# Copy to .env and fill in. Never commit .env.

PORT=3000

# Where this server is reached from outside. Used to build the verify link in receipts and emails.
# Local: http://localhost:3000   Production: https://your-domain
PUBLIC_BASE_URL=http://localhost:3000

# Gemini (https://aistudio.google.com/apikey). The key stays on the server.
# If the key is empty, email drafts and digests use the built-in templates.
GEMINI_API_KEY=
# One model, or several separated by commas (tried in order within 8 seconds).
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash

# MongoDB Atlas connection string, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/campusfallback
# If empty, receipts are kept in memory only and are lost on restart (local testing only).
MONGODB_URI=

# Comma-separated origins allowed to call /api from a browser. Add https://your-domain after deploying.
ALLOWED_ORIGINS=chrome-extension://leojplfopmmgfldnbdalehcokjldbdcp,http://localhost:3000

# Optional: path to the openssl binary (default: "openssl" from PATH)
# OPENSSL_BIN=/usr/bin/openssl
