{
  "manifest_version": 3,
  "name": "CampusFallback",
  "version": "0.1.0",
  "description": "Keeps your Canvas courses available offline and protects your deadlines during outages.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "action": {
    "default_title": "Open CampusFallback",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.gradescope.com/courses/*",
        "http://localhost:4000/gradescope/courses/*"
      ],
      "js": [
        "content/gradescope.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://umamherst.instructure.com/*"
      ],
      "js": [
        "content/canvas.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:3000/*",
    "https://umamherst.instructure.com/*",
    "https://*.instructure.com/*",
    "https://*.inscloudgate.net/*",
    "https://www.gradescope.com/*"
  ]
}
